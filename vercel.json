{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/process-image-generation",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/youtube/publish/process",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/facebook/publish/process",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/instagram/publish/process",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/youtube/data-retention",
      "schedule": "17 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
