    "immer": "^11.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.555.0",
    "nanoid": "^5.1.6",
    "next": "15.5.22",
    "next-themes": "^0.4.6",
    "p-limit": "^7.2.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^14.3.8",
    "sharp": "0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "wechatpay-node-v3": "^2.2.1",
