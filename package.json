{
  "name": "tiktok-ai-mcn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": "24.18.0",
    "npm": "12.0.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.1",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "@alicloud/openapi-core": false,
    "fsevents": false,
    "unrs-resolver": false
  },
  "scripts": {
    "dev": "next dev",
    "dev:demo": "NEXT_PUBLIC_TIKTOK_GROUPS_DEMO=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "clean": "rm -rf .next node_modules/.cache",
    "canvas:additive-operation": "node -- scripts/canvas-additive-production-operation.mjs",
    "canvas:build-exact": "node -- scripts/run-canvas-build.mjs --root . --env-file .env.local",
    "canvas:prod-check": "node -- scripts/check-canvas-production-env.mjs",
    "canvas:resolve-unknown": "node -- scripts/resolve-canvas-unknown.mjs",
    "canvas:upload-sweep": "node -- scripts/sweep-canvas-upload-reservations.mjs",
    "verify:canvas-additive-production-operation": "node -- scripts/verify-canvas-additive-production-operation.mjs",
    "verify:canvas-blue-green": "node -- scripts/verify-canvas-blue-green.mjs",
    "verify:canvas-generation-backend": "node -- scripts/verify-canvas-generation-backend.mjs",
    "verify:canvas-generation-frontend": "node -- scripts/verify-canvas-generation-frontend.mjs",
    "verify:canvas-manual-recovery": "node -- scripts/verify-canvas-manual-recovery.mjs",
    "verify:canvas-media-persistence": "node -- scripts/verify-canvas-media-persistence.mjs",
    "verify:canvas-project-lifecycle": "node -- scripts/verify-canvas-project-lifecycle.mjs",
    "verify:canvas-reconciler-worker": "node -- scripts/verify-canvas-reconciler-worker.mjs",
    "verify:canvas-upload-hardening": "node -- scripts/verify-canvas-upload-hardening.mjs",
    "verify:canvas-upload-registry": "node -- scripts/verify-canvas-upload-registry.mjs",
    "verify:canvas-upload-sweeper-install": "node -- scripts/verify-canvas-upload-sweeper-install.mjs",
    "verify:admin-api-auth": "node -- scripts/verify-admin-api-auth.mjs",
    "verify:production-supply-chain": "node -- scripts/verify-production-supply-chain.mjs"
  },
  "dependencies": {
    "@ai-sdk/xai": "^3.0.91",
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@alicloud/dysmsapi20170525": "^4.4.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
