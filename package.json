    "pg": "^8.20.0",
    "postcss": "8.5.24",
    "tailwindcss": "^3.4.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "ajv@^6": "6.14.0",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "brace-expansion": "5.0.8",
    "flatted@^3": "3.4.2",
    "form-data": "4.0.6",
    "js-yaml@^4": "4.3.0",
    "lodash": "4.18.1",
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "minimatch@^3": "3.1.4",
    "minimatch@^9": "9.0.7",
    "postcss": "8.5.24",
    "qs": "6.15.3",
    "readdirp": {
      "picomatch": "2.3.2"
    },
    "sharp": "0.35.3",
