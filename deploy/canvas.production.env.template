# Merge these names into the release's root-only .env.local.
# Values are intentionally blank. Never commit a populated copy.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CN OAuth broker trust. Node reads this only at process startup.
# Required whenever OAUTH_BROKER_URL is configured.
NODE_EXTRA_CA_CERTS=/var/www/tiktok-ai-mcn/certs/broker-ca.crt

# Alibaba Cloud OSS
ALIYUN_OSS_REGION=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_CUSTOM_DOMAIN=

# Unified image provider
VIDEO_PLATFORM_IMAGE_BASE_URL=
VIDEO_PLATFORM_IMAGE_API_KEY=

# Unified video provider
VIDEO_PLATFORM_BASE_URL=
VIDEO_PLATFORM_API_KEY=

# Canvas reconciliation authentication (at least 32 random characters)
CANVAS_RECONCILE_SECRET=

# Manual unknown-video recovery. These three secrets must be independent.
# The operator and approver labels identify two different humans in the
# append-only audit record; use 3-48 ASCII characters from A-Z a-z 0-9 . _ @ -.
CANVAS_RECOVERY_ADMIN_SECRET=
CANVAS_RECOVERY_APPROVER_SECRET=
CANVAS_RECOVERY_OPERATOR_LABEL=
CANVAS_RECOVERY_APPROVER_LABEL=

# Canvas release gates (literal true or false)
CANVAS_PUBLIC_ENABLED=false
NEXT_PUBLIC_CANVAS_ENABLED=false

# Canary users (required while CANVAS_PUBLIC_ENABLED=false)
CANVAS_ACCESS_USER_IDS=

# Server-side generation model allowlist (current production recommendation)
CANVAS_VIDEO_MODELS=grok
NEXT_PUBLIC_CANVAS_VIDEO_MODELS=grok
