# ============================================================================
# .env.example —— 只有键名,没有任何真实值。复制成 .env.local 后由项目所有者提供值。
#
# ⚠️ .env.local 是 git-ignored 的,**永远不要提交它**。
# ⚠️ 本文件里的键名不是秘密;值才是。别把填好的 .env.local 贴进 issue/PR/聊天记录。
#
# 🔴 超级画布开发者最容易踩的坑(有据可查的长期误判):
#    画布生成报 401 时,几乎所有人第一反应是「厂商凭证过期了」——**基本都是错的**。
#    真因通常是下面 VIDEO_PLATFORM_* 那 12 个键**整块缺失**,三级回退全落空才 401。
#    换 worktree / 重装环境后要重新配一次。
# ============================================================================

# ---- Supabase(数据库 + 鉴权)-------------------------------------------------
# 🔴 注意:项目目前 dev 也指向**生产** Supabase。你本地跑出来的画布/生成/积分都是真数据。
# SUPABASE_SERVICE_ROLE_KEY 可绕过所有 RLS,等同数据库管理员,务必只放本地。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- 🔴 视频/图片统一网关(画布生成的命根子,缺一块就全链路 401)-----------------
VIDEO_PLATFORM_BASE_URL=
VIDEO_PLATFORM_API_KEY=
VIDEO_PLATFORM_IMAGE_BASE_URL=
VIDEO_PLATFORM_IMAGE_API_KEY=
VIDEO_PLATFORM_IMAGE_MODEL=
VIDEO_PLATFORM_IMAGE_QUALITY=
VIDEO_PLATFORM_IMAGE_OSS_PREFIX=
VIDEO_PLATFORM_IMAGE_OUTPUT_FORMAT=
VIDEO_PLATFORM_IMAGE_OUTPUT_COMPRESSION=
VIDEO_PLATFORM_IMAGE_ENABLE_FORMAT_OPTIONS=
VIDEO_PLATFORM_IMAGE_MAX_POLL_MS=
VIDEO_PLATFORM_IMAGE_REQUEST_TIMEOUT_MS=

# ---- 超级画布开关(运行时读,改完重启即可,不用重新构建)------------------------
NEXT_PUBLIC_CANVAS_ENABLED=
CANVAS_PUBLIC_ENABLED=
CANVAS_VIDEO_MODELS=
NEXT_PUBLIC_CANVAS_VIDEO_MODELS=

# ---- 阿里云 OSS(画布只存 object key,渲染时换签名 URL)------------------------
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_CUSTOM_DOMAIN=
OPENAI_IMAGE_OSS_PREFIX=
IMAGE_REFERENCE_ALLOWED_HOSTS=

# ---- 视觉/文本模型(商品节点解析卖点走豆包,失败回退 qwen)---------------------
DOUBAO_API_KEY=
DOUBAO_ENDPOINT_ID=
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_KEY=
ARK_API_KEY=
ARK_ENDPOINT_STANDARD=
DASHSCOPE_API_KEY=
DASHSCOPE_VL_MODEL=
DASHSCOPE_TEXT_MODEL=
DEEPSEEK_API_KEY=
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_API_ENDPOINT=

# ---- 其它视频厂商(画布当前只放行 happyhorse;grok 因厂商无通道被摘出,代码保留)--
VEO3_API_KEY=
VEO3_API_ENDPOINT=
VEO3_GAORUI_API_KEY=
SORA2_API_KEY=
SORA2_API_ENDPOINT=
WANGJING_API_KEY=
WANGJING_API_ENDPOINT=
WUYIN_API_KEY=
WUYINKEJI_API_KEY=
SUCHUANG_API_KEY=
ELEVENLABS_API_KEY=

# ---- 应用与定时任务 ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ENABLE_DECONSTRUCT=
CRON_SECRET=

# ---- 支付与第三方平台(画布用不到,但缺了会影响 build/其它页面)-----------------
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_REDIRECT_URI=
