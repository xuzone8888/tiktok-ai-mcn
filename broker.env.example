# StarGaze OAuth Broker env 模板。真实值放 broker.env（chmod 600、已 gitignore，绝不进 git/镜像层）。
# broker 只做 Meta/Google 调用并回传 JSON，密钥面比 worker 小：不含 Supabase*/OSS/CRON_SECRET（除非 Phase 0 证实必需）。
#
# ⚠️ broker 绝不设 OAUTH_BROKER_URL —— 那只在 CN .env.local 设；broker 设了会自调死循环（路由有递归护栏兜底）。

# ── 鉴权：CN↔broker 共享密钥（与 CN .env.local 同值）──
BROKER_SECRET=                      # openssl rand -hex 32

# ── Caddy TLS 入口（transport 细节全走 env，不写死）──
BROKER_PUBLIC_ADDR=152.53.194.157   # CN 连接用的地址，决定 TLS 证书 SAN（IP 或自有内网主机名）
BROKER_TLS_PORT=18443               # 容器内 Caddy 监听端口（= 证书端口）
BROKER_HOST_PORT=18443              # 发布到 host 的端口；源 IP 钉死在 DOCKER-USER/云安全组

# ── Facebook ──
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=              # 必须 == CN 已注册值（toryxai.com/...），否则 token 交换 redirect_uri 不匹配
FACEBOOK_PAGE_LOGIN_CONFIG_ID=
FACEBOOK_API_VERSION=v20.0

# ── YouTube / Google（二选一组别名均可）──
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=               # 必须 == CN 已注册值
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# ── Instagram（生产 = 原生模式）──
INSTAGRAM_AUTH_MODE=instagram
INSTAGRAM_NATIVE_CLIENT_ID=
INSTAGRAM_NATIVE_CLIENT_SECRET=
INSTAGRAM_NATIVE_REDIRECT_URI=      # 必须 == CN 已注册值
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_API_VERSION=v20.0
# INSTAGRAM_NATIVE_EMBED_URL=

# ── Phase 0 待定：broker 不带 Supabase 能否干净 build/启动；若 collect-page-data 或启动崩，
#    优先填合法占位（supabase-js 构造惰性、不发网络），占位不行再放真值。记录实际最小集。──
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
