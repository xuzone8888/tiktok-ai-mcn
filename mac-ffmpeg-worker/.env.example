# Mac Studio FFmpeg Worker 环境变量
# 复制为 .env 后填入实际值

# Worker 鉴权 Token（ECS 请求时需携带此 Token）
WORKER_AUTH_TOKEN=your-secret-token-here

# Worker 端口
WORKER_PORT=9090

# 阿里云 OSS 配置（与 ECS 端 src/lib/oss.ts 一致）
ALIYUN_OSS_REGION=oss-cn-beijing
ALIYUN_OSS_ACCESS_KEY_ID=your-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_OSS_BUCKET=tokfactory-videos
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_CUSTOM_DOMAIN=media.toryxai.com
