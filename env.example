# Supabase 配置
# 请复制此文件为 .env.local 并填入您的凭据

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 可选：Supabase Service Key (服务端使用)
# SUPABASE_SERVICE_KEY=your_supabase_service_key

# ===========================================
# 速创 API 配置 (Sora2 / NanoBanana)
# ===========================================
# 速创 API 端点
SUCHUANG_API_ENDPOINT=https://api.wuyinkeji.com

# 速创 API Key
SUCHUANG_API_KEY=your_suchuang_api_key

# ===========================================
# 图片生成 API 配置 (Video Platform / GPT Image 2)
# ===========================================
# 单图/多图图片生成 worker 使用以下 VIDEO_PLATFORM_IMAGE_* 配置
VIDEO_PLATFORM_IMAGE_BASE_URL=https://api.aixoras.com
VIDEO_PLATFORM_IMAGE_API_KEY=your_video_platform_image_api_key
VIDEO_PLATFORM_IMAGE_MODEL=gpt-image-2
VIDEO_PLATFORM_IMAGE_OSS_PREFIX=video-platform-image
VIDEO_PLATFORM_IMAGE_REQUEST_TIMEOUT_MS=300000
VIDEO_PLATFORM_IMAGE_MAX_POLL_MS=900000
VIDEO_PLATFORM_IMAGE_ENABLE_FORMAT_OPTIONS=false

# 仅允许这些 HTTPS 域名作为用户参考图来源，逗号分隔
IMAGE_REFERENCE_ALLOWED_HOSTS=media.toryxai.com

# 后台图片生成 cron/worker 鉴权密钥
CRON_SECRET=your_cron_secret

# 旧 OpenAI 配置可保留给其它功能，不作为 quick-gen 图片 worker 的唯一就绪条件
OPENAI_API_KEY=your_openai_api_key
# 可选：覆盖默认图片模型（默认 gpt-image-2）
# OPENAI_IMAGE_MODEL=gpt-image-2
# 可选：自定义 OpenAI 兼容网关
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===========================================
# 豆包 API 配置 (火山引擎 ARK)
# ===========================================
# 豆包 API 端点
DOUBAO_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 豆包 API 密钥 (在火山引擎控制台获取)
DOUBAO_API_KEY=your_doubao_api_key

# 豆包推理接入点 ID (必须创建视觉模型的推理接入点)
# 步骤: 火山引擎控制台 -> 在线推理 -> 推理接入点 -> 创建 -> 选择 doubao-seed-1.6-vision
# 格式: ep-20240101000000-xxxxx
DOUBAO_ENDPOINT_ID=your_endpoint_id

# ===========================================
# 统一视频模型平台
# ===========================================
VIDEO_PLATFORM_API_KEY=your_video_platform_api_key
VIDEO_PLATFORM_BASE_URL=https://api.hellobabygo.com

# ===========================================
# 旧配置 (保留兼容)
# ===========================================
# Sora API Key (备用，优先使用 SUCHUANG_API_KEY)
SORA_API_KEY=your_sora_api_key

# ===========================================
# TikTok Content API (Login Kit + Content Posting)
# ===========================================
# From TikTok Developer Portal > App > Manage Apps
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=https://your-domain.com/api/tiktok/auth/callback

# ===========================================
# YouTube Data API (OAuth + Video Upload)
# ===========================================
# From Google Cloud Console > APIs & Services > Credentials
YOUTUBE_CLIENT_ID=your_youtube_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_oauth_client_secret
YOUTUBE_REDIRECT_URI=https://your-domain.com/api/youtube/auth/callback
YOUTUBE_API_KEY=your_restricted_youtube_data_api_key

# ===========================================
# TikTok Shop OAuth (Partner Center)
# ===========================================
# From TikTok Shop Partner Center > App Management
TIKTOK_SHOP_APP_KEY=your_shop_app_key
TIKTOK_SHOP_APP_SECRET=your_shop_app_secret
TIKTOK_SHOP_REDIRECT_URI=https://your-domain.com/api/tiktok-shop/auth/callback
TIKTOK_SHOP_SERVICE_ID=your_shop_service_id
