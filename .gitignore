# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/.next.*/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
/certs/

# debug
*.log
screenlog.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env.local*
.env
*.env
worker.env
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# temp / test files
.temp/
.tmp/
test-slideshow/
*.mp4
nohup.out
__pycache__/
# Template preview videos (served from OSS CDN)
public/videos/templates/
.env*
# 例外:.env.example 只有键名、没有任何值,是新人上手的唯一凭据清单来源,必须进版本库。
# ⚠️ 第 39 行本来就有同样一条,但被上面第 54 行的 `.env*` 重新盖掉了 —— gitignore 取最后命中,
# 所以这条必须留在 `.env*` 之后。真正带值的 .env / .env.local 仍被 `.env*` 挡着。
!.env.example
