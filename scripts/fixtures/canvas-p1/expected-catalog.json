      "table": "generations",
      "name": "valid_library_status",
      "type": "c",
      "validated": true,
      "definition": "CHECK (library_status IS NULL OR (library_status = ANY (ARRAY['draft'::text, 'ready'::text, 'published'::text])))"
    },
    {
      "table": "generations",
      "name": "valid_source",
      "type": "c",
      "validated": false,
      "definition": "CHECK ((source = ANY (ARRAY['quick_gen'::text, 'batch_image'::text, 'image_factory'::text, 'pro_studio'::text, 'link_video'::text, 'viral_clone'::text, 'ecom_factory'::text, 'studio'::text, 'slideshow'::text, 'photo_post'::text])) OR source ~~ 'batch_video%'::text) NOT VALID"
