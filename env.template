# ==========================================
# Tok Factory - 环境变量配置模板
# ==========================================
# 在 Vercel 部署时，需要在 Settings > Environment Variables 中配置这些变量

# ------------------------------------------
# 1. Supabase 配置 (必需)
# ------------------------------------------
# 从 Supabase 项目设置 > API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------
# 2. 豆包 (Doubao) API 配置 (必需)
# ------------------------------------------
# 从火山引擎 ARK 平台获取
# 也兼容 ARK_API_KEY
DOUBAO_API_KEY=your-doubao-api-key
# 也兼容 ARK_DOUBAO_ENDPOINT_ID
DOUBAO_ENDPOINT_ID=your-doubao-endpoint-id

# ------------------------------------------
# 3. Sora2 视频生成 API 配置 (必需)
# ------------------------------------------
# 数创科技 API
SORA2_API_KEY=your-sora2-api-key
SUCHUANG_API_KEY=your-suchuang-api-key

# ------------------------------------------
# 3.1 VEO3 视频生成 API 配置 (可选 - 备选路线)
# ------------------------------------------
# APIMart VEO3 API - https://docs.apimart.ai/
VEO3_API_KEY=your-veo3-api-key
VEO3_API_ENDPOINT=https://api.apimart.ai

# ------------------------------------------
# 4. 图片生成 API 配置 (Video Platform / GPT Image 2)
# ------------------------------------------
# 单图/多图图片生成 worker 使用以下 VIDEO_PLATFORM_IMAGE_* 配置
VIDEO_PLATFORM_IMAGE_BASE_URL=https://api.aixoras.com
VIDEO_PLATFORM_IMAGE_API_KEY=your-video-platform-image-api-key
VIDEO_PLATFORM_IMAGE_MODEL=gpt-image-2
VIDEO_PLATFORM_IMAGE_OSS_PREFIX=video-platform-image
VIDEO_PLATFORM_IMAGE_REQUEST_TIMEOUT_MS=300000
VIDEO_PLATFORM_IMAGE_MAX_POLL_MS=900000
VIDEO_PLATFORM_IMAGE_ENABLE_FORMAT_OPTIONS=false

# 仅允许这些 HTTPS 域名作为用户参考图来源，逗号分隔
IMAGE_REFERENCE_ALLOWED_HOSTS=media.toryxai.com

# 后台图片生成 cron/worker 鉴权密钥
CRON_SECRET=your-cron-secret

# 旧 OpenAI 配置可保留给其它功能，不作为 quick-gen 图片 worker 的唯一就绪条件
OPENAI_API_KEY=your-openai-api-key
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------
# 5. 应用配置
# ------------------------------------------
# 生产环境 URL (Vercel 部署后的域名)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ------------------------------------------
# 6. 管理员配置
# ------------------------------------------
# 管理员邮箱 (用于后台访问权限控制)
ADMIN_EMAIL=admin@example.com

# ------------------------------------------
# 7. TikTok Content API (Login Kit + Content Posting)
# ------------------------------------------
# From TikTok Developer Portal
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=https://your-domain.com/api/tiktok/auth/callback

# ------------------------------------------
# 8. YouTube Data API (OAuth + Video Upload)
# ------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials
YOUTUBE_CLIENT_ID=your-youtube-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-oauth-client-secret
YOUTUBE_REDIRECT_URI=https://your-domain.com/api/youtube/auth/callback
YOUTUBE_API_KEY=your-restricted-youtube-data-api-key

# ------------------------------------------
# 9. Facebook Graph API (OAuth + Page Video Upload)
# ------------------------------------------
# From Meta for Developers > App Dashboard
# Required Page permissions: pages_show_list, pages_manage_metadata,
# pages_read_engagement, pages_manage_posts.
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=https://your-domain.com/api/facebook/auth/callback
FACEBOOK_API_VERSION=v20.0
FACEBOOK_PAGE_LOGIN_CONFIG_ID=your-facebook-page-only-business-login-config-id

# ------------------------------------------
# 10. Instagram Graph API (OAuth + Reels Publishing)
# ------------------------------------------
# Defaults to the Facebook app credentials when INSTAGRAM_CLIENT_* is omitted.
# Use "instagram" for Instagram-only login UX, or "facebook" for the legacy
# Facebook Login flow that requires selecting the linked Facebook Page.
INSTAGRAM_AUTH_MODE=instagram
# Preferred for Instagram API with Instagram Login. Use the Instagram App ID
# and Instagram App Secret from:
# App Dashboard > Instagram > API setup with Instagram login
# > 3. Set up Instagram business login > Business login settings.
INSTAGRAM_NATIVE_CLIENT_ID=your-instagram-app-id
INSTAGRAM_NATIVE_CLIENT_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=https://your-domain.com/api/instagram/auth/callback
INSTAGRAM_API_VERSION=v20.0
# Development only: public HTTPS base URL used for locally uploaded videos so
# Instagram can fetch video_url during publishing, e.g. a Cloudflare tunnel.
INSTAGRAM_PUBLIC_MEDIA_BASE_URL=https://your-tunnel.trycloudflare.com
# Optional: paste the Embed URL copied from the same Business login settings.
# The app will add its own state and callback URL when launching OAuth.
INSTAGRAM_NATIVE_EMBED_URL=your-instagram-business-login-embed-url
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your-instagram-webhook-verify-token
# Native Instagram Login requests instagram_business_* scopes directly.
# Legacy Facebook Login config, used only when INSTAGRAM_AUTH_MODE=facebook.
INSTAGRAM_CLIENT_ID=your-legacy-facebook-login-app-id
INSTAGRAM_CLIENT_SECRET=your-legacy-facebook-login-app-secret
INSTAGRAM_LOGIN_CONFIG_ID=your-legacy-facebook-login-instagram-config-id

# ------------------------------------------
# 11. TikTok Shop OAuth (Partner Center)
# ------------------------------------------
# From TikTok Shop Partner Center > App Management
TIKTOK_SHOP_APP_KEY=your-shop-app-key
TIKTOK_SHOP_APP_SECRET=your-shop-app-secret
TIKTOK_SHOP_REDIRECT_URI=https://your-domain.com/api/tiktok-shop/auth/callback
TIKTOK_SHOP_SERVICE_ID=your-shop-service-id
