# ==========================================
# Tok Factory - 环境变量配置模板
# ==========================================
# 在 Vercel 部署时，需要在 Settings > Environment Variables 中配置这些变量

# ------------------------------------------
# 1. Supabase 配置 (必需)
# ------------------------------------------
# 从 Supabase 项目设置 > API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------
# 2. 豆包 (Doubao) API 配置 (必需)
# ------------------------------------------
# 从火山引擎 ARK 平台获取
# 也兼容 ARK_API_KEY
DOUBAO_API_KEY=your-doubao-api-key
# 也兼容 ARK_DOUBAO_ENDPOINT_ID
DOUBAO_ENDPOINT_ID=your-doubao-endpoint-id

# ------------------------------------------
# 3. Sora2 视频生成 API 配置 (必需)
# ------------------------------------------
# 数创科技 API
SORA2_API_KEY=your-sora2-api-key
SUCHUANG_API_KEY=your-suchuang-api-key

# ------------------------------------------
# 3.1 VEO3 视频生成 API 配置 (可选 - 备选路线)
# ------------------------------------------
# APIMart VEO3 API - https://docs.apimart.ai/
VEO3_API_KEY=your-veo3-api-key
VEO3_API_ENDPOINT=https://api.apimart.ai

# ------------------------------------------
# 4. 图片生成 API 配置 (Video Platform / GPT Image 2)
# ------------------------------------------
# 单图/多图图片生成 worker 使用以下 VIDEO_PLATFORM_IMAGE_* 配置
VIDEO_PLATFORM_IMAGE_BASE_URL=https://api.aixoras.com
VIDEO_PLATFORM_IMAGE_API_KEY=your-video-platform-image-api-key
VIDEO_PLATFORM_IMAGE_MODEL=gpt-image-2
VIDEO_PLATFORM_IMAGE_OSS_PREFIX=video-platform-image
VIDEO_PLATFORM_IMAGE_REQUEST_TIMEOUT_MS=300000
VIDEO_PLATFORM_IMAGE_MAX_POLL_MS=900000
VIDEO_PLATFORM_IMAGE_ENABLE_FORMAT_OPTIONS=false

# 仅允许这些 HTTPS 域名作为用户参考图来源，逗号分隔
IMAGE_REFERENCE_ALLOWED_HOSTS=media.toryxai.com

# 后台图片生成 cron/worker 鉴权密钥
CRON_SECRET=your-cron-secret

# 旧 OpenAI 配置可保留给其它功能，不作为 quick-gen 图片 worker 的唯一就绪条件
OPENAI_API_KEY=your-openai-api-key

# Shared social comment translation (optional; defaults to configured Doubao, otherwise DeepSeek)
COMMENT_TRANSLATION_PROVIDER=doubao
# COMMENT_TRANSLATION_MODEL=your-translation-model-or-endpoint-id
# DEEPSEEK_API_KEY=your-deepseek-api-key
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------
# 5. 应用配置
# ------------------------------------------
# 生产环境 URL (Vercel 部署后的域名)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ------------------------------------------
# 6. 管理员配置
# ------------------------------------------
# 管理员邮箱 (用于后台访问权限控制)
ADMIN_EMAIL=admin@example.com

# ------------------------------------------
# 7. Social Comments (platform rollout, production off by default)
# ------------------------------------------
# YouTube review demo requires these three values together:
# SOCIAL_COMMENTS_API_ENABLED=true
# SOCIAL_COMMENTS_ENABLED_PLATFORMS=youtube
# NEXT_PUBLIC_YOUTUBE_COMMENTS_ENABLED=true
# Do not enable NEXT_PUBLIC_SOCIAL_COMMENTS_CENTER_ENABLED for YouTube-only review.
# Social comments API master switch. Keep false in production until platform review is ready.
SOCIAL_COMMENTS_API_ENABLED=false
# Server-side allowlist. For YouTube-only rollout, keep this to youtube.
SOCIAL_COMMENTS_ENABLED_PLATFORMS=youtube
# Shows the YouTube Video Management > Comment Management tab and the /youtube-publish/comments compatibility route when true.
# When false, hides the Comment Management tab and makes /youtube-publish/comments return 404.
# This is only the frontend page gate. API access is still controlled by SOCIAL_COMMENTS_API_ENABLED and SOCIAL_COMMENTS_ENABLED_PLATFORMS.
# For YouTube review demos, enable this flag only; do not enable the unified center flag.
NEXT_PUBLIC_YOUTUBE_COMMENTS_ENABLED=false
# Shows only the Native Instagram Login /instagram-publish/comments review/test route when true. Keep false by default.
# The route also requires INSTAGRAM_AUTH_MODE=instagram; Facebook Login mode always returns 404.
# This frontend gate does not enable APIs. Live testing must explicitly add instagram to SOCIAL_COMMENTS_ENABLED_PLATFORMS.
# Instagram comment testing does not enable automatic refresh or automatic replies.
NEXT_PUBLIC_INSTAGRAM_COMMENTS_ENABLED=false
# Server-side gate for manually replying to Instagram comments. Keep false until real inbound-comment sync is accepted separately.
INSTAGRAM_COMMENTS_REPLY_ENABLED=true
# Shows Facebook Video Management > Comment Management and its compatibility route.
# The server allowlist must also contain facebook. Replies remain manual and permission-checked.
NEXT_PUBLIC_FACEBOOK_COMMENTS_ENABLED=false
# Admin-only Instagram Health Check identity/transport configuration.
INSTAGRAM_META_APP_ID=
INSTAGRAM_WEBHOOK_APP_ID=
INSTAGRAM_WEBHOOK_CALLBACK_URL=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Enables conservative frontend auto refresh in YouTube Comment Management when true.
# It only syncs the currently selected YouTube video, never sends replies, and remains protected by SOCIAL_COMMENTS_API_ENABLED and SOCIAL_COMMENTS_ENABLED_PLATFORMS.
# Auto refresh performs real YouTube comment reads and consumes YouTube Data API quota.
# Auto sync is additionally throttled server-side for 5 minutes per selected YouTube video/account target. Manual sync still uses the existing shorter server throttle.
# Keep false by default until the YouTube quota strategy is approved.
YOUTUBE_COMMENTS_AUTO_SYNC_ENABLED=false
# Shows unified /social-comments center when true. Keep false for platform-by-platform review.
# Do not enable this just to run a YouTube review demo.
NEXT_PUBLIC_SOCIAL_COMMENTS_CENTER_ENABLED=false

# ------------------------------------------
# 7b. Overseas API broker (required on mainland-China production servers)
# ------------------------------------------
# HTTPS base URL of the overseas StarGaze worker. The certificate must be
# publicly trusted or its private CA must be supplied to Node at process start.
OAUTH_BROKER_URL=https://broker.example.com
# Shared bearer secret. Use the same value on the CN app and overseas worker.
BROKER_SECRET=replace-with-a-long-random-secret

# ------------------------------------------
# 8. TikTok Content API (Login Kit + Content Posting)
# ------------------------------------------
# From TikTok Developer Portal
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=https://your-domain.com/api/tiktok/auth/callback

# ------------------------------------------
# 9. YouTube Data API (OAuth + Video Upload)
# ------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials
YOUTUBE_CLIENT_ID=your-youtube-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-oauth-client-secret
# In production this must equal <NEXT_PUBLIC_APP_URL>/api/youtube/auth/callback
# and exactly match the Google Cloud OAuth client's authorized redirect URI.
YOUTUBE_REDIRECT_URI=https://your-domain.com/api/youtube/auth/callback
YOUTUBE_API_KEY=your-restricted-youtube-data-api-key

# ------------------------------------------
# 10. Facebook Graph API (OAuth + Page Video Upload)
# ------------------------------------------
# From Meta for Developers > App Dashboard
# Required Page permissions: pages_show_list, pages_manage_metadata,
# pages_read_engagement, pages_manage_posts, pages_manage_engagement.
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=https://your-domain.com/api/facebook/auth/callback
FACEBOOK_API_VERSION=v20.0
# If using FACEBOOK_PAGE_LOGIN_CONFIG_ID, the Meta Login Configuration must
# also include pages_manage_engagement. Code-side scopes alone are not enough.
FACEBOOK_PAGE_LOGIN_CONFIG_ID=your-facebook-page-only-business-login-config-id

# ------------------------------------------
# 11. Instagram Graph API (OAuth + Reels Publishing)
# ------------------------------------------
# Defaults to the Facebook app credentials when INSTAGRAM_CLIENT_* is omitted.
# Use "instagram" for Instagram-only login UX, or "facebook" for the legacy
# Facebook Login flow that requires selecting the linked Facebook Page.
INSTAGRAM_AUTH_MODE=instagram
# Preferred for Instagram API with Instagram Login. Use the Instagram App ID
# and Instagram App Secret from:
# App Dashboard > Instagram > API setup with Instagram login
# > 3. Set up Instagram business login > Business login settings.
INSTAGRAM_NATIVE_CLIENT_ID=your-instagram-app-id
INSTAGRAM_NATIVE_CLIENT_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=https://your-domain.com/api/instagram/auth/callback
# Set this explicitly to a Graph API version currently supported by the Meta app.
# Re-verify the configured version before each live comments-read acceptance run;
# do not rely on the application's fallback version.
INSTAGRAM_API_VERSION=v25.0
# Development only: public HTTPS base URL used for locally uploaded videos so
# Instagram can fetch video_url during publishing, e.g. a Cloudflare tunnel.
# For local acceptance, this must match the currently active HTTPS tunnel.
# Quick Tunnel URLs change after restart; update this value and restart the dev server.
# Quick Tunnels are not suitable for production. Use stable object storage or a fixed domain there.
INSTAGRAM_PUBLIC_MEDIA_BASE_URL=https://your-tunnel.trycloudflare.com
# Optional: paste the Embed URL copied from the same Business login settings.
# The app will add its own state and callback URL when launching OAuth.
# If this URL already includes a scope parameter, include
# instagram_business_manage_comments there as well.
INSTAGRAM_NATIVE_EMBED_URL=your-instagram-business-login-embed-url
# Server-only random value used only for the Meta webhook GET challenge.
# Never expose this through NEXT_PUBLIC_*. POST signatures reuse the Native App secret above.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your-instagram-webhook-verify-token
# Server-only isolation gate for a dedicated webhook acceptance Preview deployment.
# When true, middleware returns 404 for every covered path except the exact /api/instagram/webhook route.
# Keep false for the normal application and never enable it on a full production deployment.
INSTAGRAM_WEBHOOK_ACCEPTANCE_ONLY=false
# Native Instagram Login requests instagram_business_* scopes directly.
# Comment permissions: instagram_business_manage_comments (native) or
# instagram_manage_comments (legacy Facebook Login).
# Legacy Facebook Login config, used only when INSTAGRAM_AUTH_MODE=facebook.
INSTAGRAM_CLIENT_ID=your-legacy-facebook-login-app-id
INSTAGRAM_CLIENT_SECRET=your-legacy-facebook-login-app-secret
INSTAGRAM_LOGIN_CONFIG_ID=your-legacy-facebook-login-instagram-config-id

# ------------------------------------------
# 12. TikTok Shop OAuth (Partner Center)
# ------------------------------------------
# From TikTok Shop Partner Center > App Management
TIKTOK_SHOP_APP_KEY=your-shop-app-key
TIKTOK_SHOP_APP_SECRET=your-shop-app-secret
TIKTOK_SHOP_REDIRECT_URI=https://your-domain.com/api/tiktok-shop/auth/callback
TIKTOK_SHOP_SERVICE_ID=your-shop-service-id
