# ==========================================
# Tok Factory - 环境变量配置模板
# ==========================================
# 在 Vercel 部署时，需要在 Settings > Environment Variables 中配置这些变量

# ------------------------------------------
# 1. Supabase 配置 (必需)
# ------------------------------------------
# 从 Supabase 项目设置 > API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------
# 2. 豆包 (Doubao) API 配置 (必需)
# ------------------------------------------
# 从火山引擎 ARK 平台获取
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_ENDPOINT_ID=your-doubao-endpoint-id

# ------------------------------------------
# 3. Sora2 视频生成 API 配置 (必需)
# ------------------------------------------
# 数创科技 API
SORA2_API_KEY=your-sora2-api-key
SUCHUANG_API_KEY=your-suchuang-api-key

# ------------------------------------------
# 3.1 VEO3 视频生成 API 配置 (可选 - 备选路线)
# ------------------------------------------
# APIMart VEO3 API - https://docs.apimart.ai/
VEO3_API_KEY=your-veo3-api-key
VEO3_API_ENDPOINT=https://api.apimart.ai

# ------------------------------------------
# 4. 图片生成 API 配置 (Video Platform / GPT Image 2)
# ------------------------------------------
# 单图/多图图片生成 worker 使用以下 VIDEO_PLATFORM_IMAGE_* 配置
VIDEO_PLATFORM_IMAGE_BASE_URL=https://api.aixoras.com
VIDEO_PLATFORM_IMAGE_API_KEY=your-video-platform-image-api-key
VIDEO_PLATFORM_IMAGE_MODEL=gpt-image-2
VIDEO_PLATFORM_IMAGE_OSS_PREFIX=video-platform-image
VIDEO_PLATFORM_IMAGE_REQUEST_TIMEOUT_MS=300000
VIDEO_PLATFORM_IMAGE_MAX_POLL_MS=900000
VIDEO_PLATFORM_IMAGE_ENABLE_FORMAT_OPTIONS=false

# 仅允许这些 HTTPS 域名作为用户参考图来源，逗号分隔
IMAGE_REFERENCE_ALLOWED_HOSTS=media.toryxai.com

# 后台图片生成 cron/worker 鉴权密钥
CRON_SECRET=your-cron-secret

# 旧 OpenAI 配置可保留给其它功能，不作为 quick-gen 图片 worker 的唯一就绪条件
OPENAI_API_KEY=your-openai-api-key
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------
# 5. 应用配置
# ------------------------------------------
# 生产环境 URL (Vercel 部署后的域名)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ------------------------------------------
# 6. 管理员配置
# ------------------------------------------
# 管理员邮箱 (用于后台访问权限控制)
ADMIN_EMAIL=admin@example.com

# ------------------------------------------
# 7. TikTok Content API (Login Kit + Content Posting)
# ------------------------------------------
# From TikTok Developer Portal
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=https://your-domain.com/api/tiktok/auth/callback

# ------------------------------------------
# 8. YouTube Data API (OAuth + Video Upload)
# ------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials
YOUTUBE_CLIENT_ID=your-youtube-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-oauth-client-secret
YOUTUBE_REDIRECT_URI=https://your-domain.com/api/youtube/auth/callback
YOUTUBE_API_KEY=your-restricted-youtube-data-api-key

# ------------------------------------------
# 9. TikTok Shop OAuth (Partner Center)
# ------------------------------------------
# From TikTok Shop Partner Center > App Management
TIKTOK_SHOP_APP_KEY=your-shop-app-key
TIKTOK_SHOP_APP_SECRET=your-shop-app-secret
TIKTOK_SHOP_REDIRECT_URI=https://your-domain.com/api/tiktok-shop/auth/callback
TIKTOK_SHOP_SERVICE_ID=your-shop-service-id
