# StarGaze OAuth Broker —— TLS 终止（tls internal）+ 只放行 /api/oauth-broker/call。
# transport 细节走 env：BROKER_PUBLIC_ADDR（证书 SAN / CN 连接地址）、BROKER_TLS_PORT（监听端口）。
{
	# 不做 HTTP→HTTPS 跳转、不申请公网证书。
	auto_https disable_redirects
}

https://{$BROKER_PUBLIC_ADDR}:{$BROKER_TLS_PORT} {
	# 监听所有容器接口（公网地址不在容器本地接口上，需显式 bind 0.0.0.0），
	# 但证书 SAN/匹配仍按 BROKER_PUBLIC_ADDR。
	bind 0.0.0.0

	# 自建本地 CA 签发内部证书；CN 端经 NODE_EXTRA_CA_CERTS 信任其根。
	tls internal

	# 仅放行 broker 调用端点，反代到 compose 内网的 broker:3100。
	@brokercall path /api/oauth-broker/call
	handle @brokercall {
		reverse_proxy broker:3100
	}

	# 其余一切路径一律 404，不暴露 Next 应用其余路由面。
	handle {
		respond "Not Found" 404
	}

	# 访问日志关到最低，绝不记 Authorization 头。
	log {
		level ERROR
	}
}
